# ==================================
# NexusAI Environment Configuration
# ==================================

# AI Providers (at least one required)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_key_here          # Optional
OLLAMA_BASE_URL=http://localhost:11434            # Optional (for local mode)

# LLM Settings
DEFAULT_LLM_PROVIDER=groq                        # groq | ollama | openai
DEFAULT_MODEL=llama-3.1-70b-versatile

# Database
DATABASE_URL=sqlite:///./data/nexusai.db          # or postgresql://user:pass@localhost:5432/nexusai

# App Settings
SECRET_KEY=change-this-to-a-random-secret-key
ENVIRONMENT=development                           # development | production
LOG_LEVEL=INFO                                    # DEBUG | INFO | WARNING | ERROR

# Rate Limiting
RATE_LIMIT_TEXT=30/minute
RATE_LIMIT_FILE=10/minute
RATE_LIMIT_HEAVY=5/minute

# File Upload Limits (bytes)
MAX_AUDIO_SIZE=26214400                           # 25MB
MAX_IMAGE_SIZE=10485760                           # 10MB
MAX_CODE_SIZE=5242880                             # 5MB
MAX_DOCUMENT_SIZE=10485760                        # 10MB
MAX_ARCHIVE_SIZE=52428800                         # 50MB

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ---- Frontend (.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
